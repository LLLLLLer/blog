{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Worker 名字决定免费域名：<name>.<你的账号子域>.workers.dev
  // 改名会换域名，别在上线后随便改
  "name": "linners-note",
  "compatibility_date": "2026-09-01",

  // 纯静态站：只有资源、没有 Worker 脚本，所以不需要 main 和 binding
  "assets": {
    "directory": "./dist",
    // dist/404.html 用作找不到页面时的响应
    "not_found_handling": "404-page"
  },

  // 自定义域名。要求该域名的 zone 托管在同一个 Cloudflare 账号下，
  // 否则 deploy 会失败。wrangler 会自动创建所需的 DNS 记录。
  "routes": [
    { "pattern": "linner.top", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  }
}
