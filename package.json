    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.10",
    "fuse.js": "^7.5.0",
    "katex": "^0.18.5",
    "mermaid": "^11.17.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
