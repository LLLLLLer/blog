---
import HeroCanvas from '../../components/motion/HeroCanvas.astro';
import EntryList from '../../components/ui/EntryList.astro';
import { SITE, SOCIALS } from '../../config';
import type { AnyEntry, WritingSection } from '../../lib/content';

interface Props {
  items: { section: WritingSection; entry: AnyEntry }[];
  works: { id: string; data: { title: string; description: string } }[];
}
const { items, works } = Astro.props;
---

<section class="hero">
  <HeroCanvas density={14} />
  <div class="hero__text">
    <h1 class="hero__name">{SITE.author}</h1>
    <p class="hero__tagline">{SITE.tagline}</p>
    {SOCIALS.length > 0 && (
      <p class="hero__socials">
        {SOCIALS.map((s) => <a href={s.href}>{s.name}</a>)}
      </p>
    )}
  </div>
</section>

{works.length > 0 && (
  <section class="block">
    <h2 class="block__title">精选项目</h2>
    <ul class="picks">
      {works.map((w) => (
        <li><a href={`/a/works/${w.id}`}>{w.data.title}</a><span>{w.data.description}</span></li>
      ))}
    </ul>
  </section>
)}

<section class="block">
  <h2 class="block__title">最新</h2>
  <EntryList theme="a" items={items} showSection />
</section>

<style>
  .hero {
    position: relative;
    padding-block: 5rem 4rem;
    overflow: hidden;
  }
  .hero__text { position: relative; z-index: 1; }
  .hero__name { font-size: clamp(2rem, 6vw, 3rem); }
  .hero__tagline {
    color: var(--fg-muted);
    margin-top: 0.85rem;
    max-width: 32rem;
    font-family: var(--font-serif);
    font-size: 1.05rem;
  }
  .hero__socials { display: flex; gap: 1.25rem; margin-top: 1.5rem; font-size: 0.85rem; }
  .hero__socials a { color: var(--accent); }

  .block { margin-top: 3.5rem; }
  .block__title {
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    color: var(--fg-muted);
    margin-bottom: 1.1rem;
  }
  .picks { display: grid; gap: 0.65rem; margin-bottom: 1rem; }
  .picks li { display: flex; gap: 0.75rem; align-items: baseline; font-size: 0.925rem; }
  .picks a { font-family: var(--font-display); color: var(--fg); }
  .picks a:hover { color: var(--accent); }
  .picks span { color: var(--fg-muted); font-size: 0.85rem; }
</style>
