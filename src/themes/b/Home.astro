---
import HeroCanvas from '../../components/motion/HeroCanvas.astro';
import EntryList from '../../components/ui/EntryList.astro';
import { SITE, SOCIALS } from '../../config';
import type { AnyEntry, WritingSection } from '../../lib/content';

interface Props {
  items: { section: WritingSection; entry: AnyEntry }[];
  works: { id: string; data: { title: string; description: string } }[];
}
const { items, works } = Astro.props;
---

<section class="hero">
  <HeroCanvas density={40} />
  <div class="hero__text">
    <p class="hero__eyebrow">// {SITE.title}</p>
    <h1 class="hero__name">{SITE.author}</h1>
    <p class="hero__tagline">{SITE.tagline}</p>
    {SOCIALS.length > 0 && (
      <p class="hero__socials">{SOCIALS.map((s) => <a href={s.href}>{s.name} ↗</a>)}</p>
    )}
  </div>
</section>

{works.length > 0 && (
  <section class="block">
    <h2 class="block__title">精选项目</h2>
    <ul class="picks">
      {works.map((w) => (
        <li class="card pick">
          <a href={`/b/works/${w.id}`}>{w.data.title}</a>
          <p>{w.data.description}</p>
        </li>
      ))}
    </ul>
  </section>
)}

<section class="block">
  <h2 class="block__title">最新</h2>
  <EntryList theme="b" items={items} showSection />
</section>

<style>
  .hero {
    position: relative;
    padding-block: 6.5rem 5rem;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .hero__text { position: relative; z-index: 1; }
  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.1em;
  }
  .hero__name { font-size: clamp(2.25rem, 7vw, 3.75rem); margin-top: 0.75rem; }
  .hero__tagline { color: var(--fg-muted); margin-top: 1rem; max-width: 34rem; }
  .hero__socials { display: flex; gap: 1.25rem; margin-top: 1.75rem; font-size: 0.85rem; }
  .hero__socials a { color: var(--accent); }

  .block { margin-top: 3.5rem; }
  .block__title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--fg-muted);
    margin-bottom: 1.1rem;
  }
  .picks { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); margin-bottom: 1rem; }
  .pick { padding: 1.1rem; border-radius: var(--radius); }
  .pick a { font-family: var(--font-display); color: var(--fg); }
  .pick a:hover { color: var(--accent); }
  .pick p { color: var(--fg-muted); font-size: 0.85rem; margin-top: 0.35rem; }
</style>
