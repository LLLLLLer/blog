---
import HeroCanvas from '../../components/motion/HeroCanvas.astro';
import EntryList from '../../components/ui/EntryList.astro';
import { SITE, SOCIALS } from '../../config';
import type { AnyEntry, WritingSection } from '../../lib/content';

interface Props {
  items: { section: WritingSection; entry: AnyEntry }[];
  works: { id: string; data: { title: string; description: string } }[];
}
const { items, works } = Astro.props;
---

<section class="cover">
  <HeroCanvas density={22} />
  <div class="cover__text">
    <p class="cover__kicker">{SITE.title}</p>
    <h1 class="display cover__name">{SITE.author}</h1>
    <p class="cover__tagline">{SITE.tagline}</p>
    {SOCIALS.length > 0 && (
      <p class="cover__socials">{SOCIALS.map((s) => <a href={s.href}>{s.name}</a>)}</p>
    )}
  </div>
</section>

{works.length > 0 && (
  <section class="block">
    <p class="block__title">精选项目</p>
    <ul class="picks">
      {works.map((w, i) => (
        <li class="entry-row">
          <span class="entry-row__index">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <a href={`/c/works/${w.id}`} class="picks__title">{w.data.title}</a>
            <p class="picks__desc">{w.data.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>
)}

<section class="block">
  <p class="block__title">最新</p>
  <EntryList theme="c" items={items} variant="rows" showSection />
</section>

<style>
  .cover {
    position: relative;
    overflow: hidden;
    padding-block: 5rem 4rem;
    margin-bottom: 1rem;
  }
  .cover__text { position: relative; z-index: 1; }
  .cover__kicker {
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.7rem;
    color: var(--fg-muted);
    margin-bottom: 1.25rem;
  }
  .cover__name { margin-bottom: 1.5rem; }
  .cover__tagline {
    font-size: 1.15rem;
    max-width: 30rem;
    color: var(--fg-muted);
    border-top: 1px solid var(--fg);
    padding-top: 1.25rem;
  }
  .cover__socials { display: flex; gap: 1.5rem; margin-top: 1.5rem; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; }
  .cover__socials a { color: var(--accent); }

  .block { margin-top: 3rem; }
  .block__title {
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.7rem;
    color: var(--fg-muted);
    margin-bottom: 0.5rem;
  }
  .picks { list-style: none; }
  .picks__title { font-family: var(--font-display); font-size: 1.4rem; color: var(--fg); }
  .picks__title:hover { color: var(--accent); }
  .picks__desc { color: var(--fg-muted); font-size: 0.9rem; margin-top: 0.3rem; }
</style>
