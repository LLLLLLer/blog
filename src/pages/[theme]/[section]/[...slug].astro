---
import { render } from 'astro:content';
import Article from '../../../layouts/Article.astro';
import { THEME_IDS } from '../../../themes';
import { getSection, type WritingSection } from '../../../lib/content';

export async function getStaticPaths() {
  const sections: WritingSection[] = ['posts', 'notes', 'lab'];
  const paths = [];
  for (const section of sections) {
    const entries = await getSection(section);
    for (const theme of THEME_IDS) {
      for (const entry of entries) {
        paths.push({ params: { theme, section, slug: entry.id }, props: { entry, section } });
      }
    }
  }
  return paths;
}

const { entry, section } = Astro.props;
const { theme } = Astro.params;
const { Content, headings } = await render(entry);
---

<Article
  theme={theme as 'a' | 'b' | 'c'}
  section={section}
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  tags={entry.data.tags}
  headings={headings}
>
  <Content />
</Article>
