---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getSection, type WritingSection } from '../../lib/content';

export async function getStaticPaths() {
  const sections: WritingSection[] = ['posts', 'notes', 'lab'];
  const paths = [];
  for (const section of sections) {
    for (const entry of await getSection(section)) {
      paths.push({ params: { section, slug: entry.id }, props: { entry, section } });
    }
  }
  return paths;
}

const { entry, section } = Astro.props;
const { Content, headings } = await render(entry);
---

<Article
  section={section}
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  tags={entry.data.tags}
  headings={headings}
>
  <Content />
</Article>
