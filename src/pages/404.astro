---
import Shell from '../layouts/Shell.astro';
import { SECTIONS } from '../config';
---

<Shell title="页面不存在">
  <div class="notfound">
    <h1 class="notfound__code">404</h1>
    <p class="notfound__text">这个地址下面没有东西。可能是链接过期了，或者我把文章挪了地方。</p>
    <p class="notfound__links">
      <a href="/">回首页</a>
      {SECTIONS.map((s) => <a href={`/${s.id}`}>{s.name}</a>)}
      <a href="/search">搜索</a>
    </p>
  </div>
</Shell>

<style>
  .notfound { padding-block: 4rem 6rem; max-width: var(--content-width); }
  .notfound__code { font-size: clamp(3rem, 12vw, 6rem); line-height: 1; }
  .notfound__text { color: var(--fg-muted); margin-top: 1rem; }
  .notfound__links { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 2rem; font-size: 0.9rem; }
  .notfound__links a { color: var(--accent); }
</style>
