---
import Shell from '../layouts/Shell.astro';
---

<Shell title="搜索" active="search">
  <h1 class="search-title">搜索</h1>

  <form class="search" role="search" data-search-root onsubmit="return false">
    <input
      type="search"
      id="q"
      class="search__input"
      placeholder="搜标题、摘要、标签…"
      autocomplete="off"
      autofocus
    />
  </form>

  <p class="search__status" data-search-status></p>
  <ul class="search__results" data-search-results></ul>
</Shell>

<script>
  import type Fuse from 'fuse.js';

  const ESCAPES: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' };

  interface SearchItem {
    section: 'posts' | 'lab' | 'notes';
    id: string;
    title: string;
    description: string;
    tags: string[];
    date: string;
  }

  const SECTION_LABEL: Record<string, string> = { posts: '技术', lab: '实验', notes: '随笔' };

  function initSearch() {
    const root = document.querySelector<HTMLElement>('[data-search-root]');
    const input = document.querySelector<HTMLInputElement>('#q');
    const results = document.querySelector<HTMLElement>('[data-search-results]');
    const status = document.querySelector<HTMLElement>('[data-search-status]');
    if (!root || !input || !results || !status || input.dataset.bound) return;
    input.dataset.bound = '1';

    let fuse: Fuse<SearchItem> | null = null;
    let loading: Promise<void> | null = null;

    // Fuse 和索引都等到用户真的开始输入才加载，搜索页本身零额外负担
    const ensureIndex = () => {
      if (loading) return loading;
      loading = (async () => {
        const [{ default: FuseCtor }, data] = await Promise.all([
          import('fuse.js'),
          fetch('/search.json').then((r) => r.json() as Promise<SearchItem[]>),
        ]);
        fuse = new FuseCtor(data, {
          keys: [
            { name: 'title', weight: 3 },
            { name: 'description', weight: 1.5 },
            { name: 'tags', weight: 1 },
          ],
          threshold: 0.4,
          ignoreLocation: true,
        });
      })();
      return loading;
    };

    const render = (matches: { item: SearchItem }[], query: string) => {
      if (!query) {
        results.innerHTML = '';
        status.textContent = '';
        return;
      }
      if (!matches.length) {
        results.innerHTML = '';
        status.textContent = `没有匹配「${query}」的内容。`;
        return;
      }
      status.textContent = `${matches.length} 条结果`;
      results.innerHTML = matches
        .map(({ item }) => {
          const label = SECTION_LABEL[item.section] ?? item.section;
          const desc = item.description
            ? `<p class="search__desc">${escapeHtml(item.description)}</p>`
            : '';
          return `<li class="search__item">
            <a href="/${item.section}/${item.id}">${escapeHtml(item.title)}</a>
            ${desc}
            <p class="search__meta">${label}</p>
          </li>`;
        })
        .join('');
    };

    const escapeHtml = (s: string) =>
      s.replace(/[&<>"]/g, (c) => ESCAPES[c] ?? c);

    let timer: ReturnType<typeof setTimeout>;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(async () => {
        const query = input.value.trim();
        if (!query) return render([], '');
        await ensureIndex();
        render(fuse!.search(query).slice(0, 30), query);
      }, 120);
    });
  }

  document.addEventListener('astro:page-load', initSearch);
</script>

<style>
  .search-title { font-size: clamp(1.75rem, 5vw, 2.5rem); margin-bottom: 1.5rem; }
  .search__input {
    width: 100%;
    max-width: 32rem;
    padding: 0.7rem 1rem;
    font-size: 1rem;
    font-family: inherit;
    color: var(--fg);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color var(--motion-fast) var(--ease-out);
  }
  .search__input:focus { border-color: var(--accent); outline: none; }
  .search__status { color: var(--fg-muted); font-size: 0.8rem; margin-top: 1rem; }
  .search__results { margin-top: 1rem; display: grid; gap: 0.85rem; }
  .search__item a { font-family: var(--font-display); font-size: 1.1rem; color: var(--fg); }
  .search__item a:hover { color: var(--accent); }
  .search__desc { color: var(--fg-muted); font-size: 0.875rem; margin-top: 0.2rem; }
  .search__meta { color: var(--fg-muted); font-size: 0.75rem; margin-top: 0.3rem; }
</style>
