---
import Base from './Base.astro';
import { SITE, SECTIONS, SOCIALS } from '../config';
import ColorToggle from '../components/ui/ColorToggle.astro';

interface Props {
  title: string;
  description?: string;
  /** 当前分区，用于导航高亮 */
  active?: string;
  /** 首页自己控制容器宽度 */
  bare?: boolean;
}

const { title, description, active, bare = false } = Astro.props;
---

<Base title={title} description={description}>
  <a href="#main" class="skip-link">跳到正文</a>

  {/* 页面顶端的哨兵：它滚出视口即代表「已滚动」，比监听 scroll 事件省 */}
  <div data-scroll-sentinel aria-hidden="true"></div>

  <header class="site-header" data-site-header>
    <div class="shell-inner site-header__inner">
      <a href="/" class="brand">{SITE.title}</a>
      <nav class="nav" aria-label="主导航">
        {SECTIONS.map((s) => (
          <a href={`/${s.id}`} class="nav-link" data-active={active === s.id ? '' : undefined}>
            {s.name}
          </a>
        ))}
        <a href="/search" class="nav-link" data-active={active === 'search' ? '' : undefined}>
          搜索
        </a>
        <ColorToggle />
      </nav>
    </div>
  </header>

  <main id="main" class={bare ? '' : 'shell-inner shell-main'}>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="shell-inner site-footer__inner">
      <p>© {new Date().getFullYear()} {SITE.author}</p>
      <p class="site-footer__links">
        {SOCIALS.map((s) => <a href={s.href}>{s.name}</a>)}
        <a href="/rss.xml">RSS</a>
      </p>
    </div>
  </footer>
</Base>

<style>
  .shell-inner {
    max-width: 62rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  .shell-main {
    padding-block: 3rem 5rem;
    min-height: 60vh;
    position: relative;
    z-index: 1;
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    padding: 0.6rem 1rem;
    background: var(--accent);
    color: var(--bg);
    z-index: 100;
  }
  .skip-link:focus { left: 0; }

  [data-scroll-sentinel] {
    position: absolute;
    top: 0;
    height: 1px;
    width: 1px;
    pointer-events: none;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    /* 实色背景，不能依赖 JS —— sticky 顶栏透明会让正文从底下透上来 */
    background: var(--bg);
    transition: box-shadow var(--motion-base) var(--ease-out),
      border-color var(--motion-base) var(--ease-out);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 3.75rem;
  }
  .brand {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--fg);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    font-size: 0.875rem;
  }
  .nav-link {
    color: var(--fg-muted);
    transition: color var(--motion-fast) var(--ease-out);
  }
  .nav-link:hover { color: var(--fg); }

  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: 2rem;
    font-size: 0.8rem;
    color: var(--fg-muted);
    position: relative;
    z-index: 1;
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
  }
  .site-footer__links { display: flex; gap: 1rem; }
  .site-footer__links a { transition: color var(--motion-fast) var(--ease-out); }
  .site-footer__links a:hover { color: var(--accent); }

  @media (max-width: 640px) {
    .site-header__inner { height: auto; padding-block: 0.75rem; flex-wrap: wrap; }
    .nav { gap: 0.85rem; font-size: 0.8rem; }
  }
</style>
