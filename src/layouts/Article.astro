---
import type { MarkdownHeading } from 'astro';
import Shell from './Shell.astro';
import Toc from '../components/ui/Toc.astro';
import Giscus from '../components/ui/Giscus.astro';
import MathStyles from '../components/ui/MathStyles.astro';
import { formatDate } from '../lib/content';

interface Props {
  section: string;
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  headings: MarkdownHeading[];
}

const { section, title, description, pubDate, updatedDate, tags = [], headings } =
  Astro.props;
---

<Shell title={title} description={description} active={section}>
  <MathStyles />
  <article class="article">
    <header class="article__head">
      <h1 class="article__title">{title}</h1>
      <p class="article__meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span> · 更新于 {formatDate(updatedDate)}</span>}
        {tags.length > 0 && <span> · {tags.join(' / ')}</span>}
      </p>
    </header>

    <div class="article__body">
      <div class="prose">
        <slot />
      </div>
      <aside class="article__aside">
        <div class="article__aside-sticky">
          <Toc headings={headings} />
        </div>
      </aside>
    </div>

    <Giscus />
  </article>
</Shell>

<style>
  .article__head { margin-bottom: 2.5rem; }
  .article__title { font-size: clamp(1.75rem, 4.5vw, 2.5rem); }
  .article__meta {
    color: var(--fg-muted);
    font-size: 0.8rem;
    margin-top: 0.7rem;
  }

  .article__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 13rem;
    gap: 3rem;
    align-items: start;
  }
  .article__aside-sticky {
    position: sticky;
    top: 5.5rem;
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
  }

  /* 窄屏没有侧栏空间，目录整体收起 */
  @media (max-width: 1023px) {
    .article__body { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .article__aside { display: none; }
  }
</style>
