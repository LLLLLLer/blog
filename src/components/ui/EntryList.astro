---
import { formatDate } from '../../lib/content';
import type { AnyEntry, WritingSection } from '../../lib/content';

interface Props {
  items: { section: WritingSection; entry: AnyEntry }[];
  showSection?: boolean;
  empty?: string;
}

const { items, showSection = false, empty = '这个分区还没有内容。' } = Astro.props;

const SECTION_LABEL: Record<WritingSection, string> = {
  posts: '技术',
  lab: '实验',
  notes: '随笔',
};
---

{items.length === 0 ? (
  <p class="entry-empty">{empty}</p>
) : (
  <ul class="entry-cards">
    {items.map(({ section, entry }, i) => (
      <li class="entry-card" data-reveal style={`--reveal-delay:${Math.min(i, 8) * 40}ms`}>
        <a href={`/${section}/${entry.id}/`} class="entry-card__title">{entry.data.title}</a>
        {entry.data.description && <p class="entry-desc">{entry.data.description}</p>}
        <p class="entry-meta">
          <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate)}</time>
          {showSection && <span> · {SECTION_LABEL[section]}</span>}
          {entry.data.tags.length > 0 && <span> · {entry.data.tags.join(' / ')}</span>}
        </p>
      </li>
    ))}
  </ul>
)}

<style>
  .entry-empty { color: var(--fg-muted); padding-block: 2rem; }

  .entry-cards { display: grid; gap: 0.5rem; }
  .entry-card {
    padding: 1.1rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color var(--motion-base) var(--ease-out);
  }
  .entry-card:hover { border-color: var(--accent); }

  .entry-card__title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--fg);
    transition: color var(--motion-fast) var(--ease-out);
  }
  .entry-card__title:hover { color: var(--accent); }

  .entry-desc {
    color: var(--fg-muted);
    font-size: 0.9rem;
    margin-top: 0.3rem;
  }
  .entry-meta {
    color: var(--fg-muted);
    font-size: 0.775rem;
    margin-top: 0.45rem;
  }
</style>
