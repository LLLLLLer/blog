---
/**
 * 候选 B 的光标辉光。属于「重特效」：
 * data-heavy-motion 让它在窄屏和 prefers-reduced-motion 下整体不渲染（见 base.css）。
 */
---
<div class="cursor-glow" data-heavy-motion aria-hidden="true"></div>

<script>
  function bind() {
    const glow = document.querySelector<HTMLElement>('.cursor-glow');
    if (!glow || glow.dataset.bound) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(max-width: 767px)').matches) return;
    glow.dataset.bound = '1';

    let raf = 0;
    let x = window.innerWidth / 2;
    let y = window.innerHeight / 2;

    const paint = () => {
      raf = 0;
      glow.style.setProperty('--x', `${x}px`);
      glow.style.setProperty('--y', `${y}px`);
    };

    window.addEventListener(
      'pointermove',
      (e) => {
        x = e.clientX;
        y = e.clientY;
        // 每帧最多写一次样式，pointermove 触发频率远高于刷新率
        if (!raf) raf = requestAnimationFrame(paint);
      },
      { passive: true },
    );
  }
  document.addEventListener('astro:page-load', bind);
</script>
